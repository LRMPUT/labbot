<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="wheel_link_macro" params="prefix diameter width material">
        <link name="${prefix}_link">
            <visual>
                <geometry>
                    <cylinder radius="${diameter / 2.0}" length="${width}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="${material}" />
            </visual>
        </link>  
    </xacro:macro>

</robot>