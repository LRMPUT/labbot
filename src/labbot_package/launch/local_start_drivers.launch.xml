<launch>
  <arg name="use_sim_time" default="false"/>

<!-- slam config import -->
  <arg name="slam_params_file" default="$(find-pkg-share labbot_package)/config/slam_config.yaml"/>

<!-- scan config, can be put in external config file -->
  <arg name="depth_topic" default="/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/camera/depth/camera_info"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="output_frame" default="scan_link"/>
  <arg name="scan_height" default="2"/>
  <arg name="range_min" default="0.60"/>
  <arg name="range_max" default="8.0"/>
  <arg name="scan_time" default="0.033"/>

<!-- micro-ROS start -->
  <node
    pkg="micro_ros_agent"
    exec="micro_ros_agent"
    name="micro_ros_agent"
    output="screen"
    respawn="true"
    emulate_tty="true"
    args="serial --dev /dev/ttyACM0 --verbose 4" />

<!-- robot_state_publisher start ith URDF config -->
  <node
    pkg="robot_state_publisher"
    exec="robot_state_publisher"
    name="robot_state_publisher"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param
      name="robot_description"
      value="$(command 'xacro $(find-pkg-share labbot_package)/urdf/labbot.xacro')"/>
    <remap from="joint_states" to="/labbot/motor_state"/>
  </node>

<!-- robot_localization start with localization config (imu can be implemented as a part of EKF) -->
  <node
    pkg="robot_localization"
    exec="ekf_node"
    name="ekf_odom"
    output="screen">
    <param from="$(find-pkg-share labbot_package)/config/localization_config.yaml"/>
  </node>

<!-- slam_toolbox start with SLAM config -->
  <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
    <arg name="slam_params_file" value="$(var slam_params_file)"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>

<!-- start Astra camera launch file, camera config is adjusted for used scan/slam -->
  <include file="$(find-pkg-share astra_camera)/launch/astra.launch.xml"> </include>

<!-- scan start to allow SLAM read its surroundings -->
  <node
    pkg="depthimage_to_laserscan"
    exec="depthimage_to_laserscan_node"
    name="depthimage_to_laserscan"
    output="screen"
    emulate_tty="true">

    <remap from="depth" to="$(var depth_topic)"/>
    <remap from="depth_camera_info" to="$(var camera_info_topic)"/>
    <remap from="scan" to="$(var scan_topic)"/>

    <param name="scan_time" value="$(var scan_time)"/>
    <param name="output_frame" value="$(var output_frame)"/>
    <param name="scan_height" value="$(var scan_height)"/>
    <param name="range_min" value="$(var range_min)"/>
    <param name="range_max" value="$(var range_max)"/>
  </node>
</launch>